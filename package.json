{
  "name": "xcompress",
  "version": "0.1.1",
  "description": "Build-time code compression for serverless functions: bundle dependencies into a single minified file (Node) or slim the deployment package (Python) to cut cold-start time.",
  "bin": {
    "scc": "bin/cli.js"
  },
  "main": "src/index.js",
  "type": "commonjs",
  "files": [
    "bin",
    "src",
    "README.md",
    "REPRODUCIBILITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run.js",
    "test:e2e": "node e2e-scenarios/run-all.js",
    "verify": "npm test && npm run test:e2e"
  },
  "keywords": [
    "serverless",
    "cold-start",
    "code-compression",
    "bundle",
    "esbuild",
    "webpack",
    "faas",
    "function-compute",
    "scf"
  ],
  "license": "MIT",
  "author": "anycodes",
  "repository": {
    "type": "git",
    "url": "https://github.com/anycodes/xCompress"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "esbuild": "0.21.5"
  },
  "optionalDependencies": {
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "0.4.4",
    "rollup": "4.61.0",
    "terser-webpack-plugin": "5.3.17",
    "webpack": "5.108.4"
  }
}
